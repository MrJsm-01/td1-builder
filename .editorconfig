root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,html,svg}]
indent_style = tab
tab_width = 4

[*.md]
trim_trailing_whitespace = false

[*.txt]
insert_final_newline = false

[*.{rb,yml}]
end_of_line = lf

[*.{js,md,rb,scss,txt,yml}]
indent_style = space
indent_size = 2

[{Gemfile*,bin/**}]
indent_style = space
indent_size = 2
end_of_line = lf
